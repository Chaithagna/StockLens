# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# Provide a standard MongoDB connection string, or leave empty/set USE_MEMORY_DB=true to use automatic embedded in-memory MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/stocklens
USE_MEMORY_DB=false

# Authentication
JWT_SECRET=stocklens_super_secret_jwt_key_investment_research_2026_dev
JWT_EXPIRES_IN=7d

# External APIs (Optional - intelligent heuristic fallbacks are active if left blank)
# Google Maps Platform (Places API, Street View)
GOOGLE_MAPS_API_KEY=

# Financial Data APIs (Finnhub / Alpha Vantage)
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# News and Web Search APIs (Tavily / Serper / NewsAPI)
TAVILY_API_KEY=
NEWS_API_KEY=

# AI & LLM Service (Google Gemini or OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=

